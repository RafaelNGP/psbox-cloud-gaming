// FSR 1 RCAS (sharpening; off = a plain copy), then the menus laid over, into
// the swapchain image. The picture comes in 16-bit float and is rounded to the
// swapchain's 8 bits only here, with a fixed dither pattern, so smooth
// gradients don't turn into steps.
#extension GL_GOOGLE_include_directive : require
layout(local_size_x = 8, local_size_y = 8) in;
layout(binding = 0, rgba16f) uniform readonly image2D upscaled;
layout(binding = 1) uniform sampler2D overlayTex;  // linear, alpha = coverage
layout(binding = 2) uniform writeonly image2D target;  // the swapchain's format
layout(push_constant) uniform Constants {
    uvec4 con;       // FsrRcasCon
    uint sharpen;    // 0: plain copy
    float overlayOpacity;
    float dither;    // in 8-bit steps: 1 = +-half a step (the video); 0 = none (the menus)
    uint quant8;     // measurements: the input rounded to 8 bits, as before the 16-bit images
} pc;

#define A_GPU 1
#define A_GLSL 1
#include "ffx_a.h"
#define FSR_RCAS_F 1
#define FSR_RCAS_DENOISE 1
AF4 FsrRcasLoadF(ASU2 p) {
    ivec2 size = imageSize(upscaled);
    vec4 v = imageLoad(upscaled, clamp(p, ivec2(0), size - 1));
    return pc.quant8 != 0u ? floor(v * 255.0 + 0.5) / 255.0 : v;
}
void FsrRcasInputF(inout AF1 r, inout AF1 g, inout AF1 b) {}
#include "ffx_fsr1.h"

void main() {
    ivec2 p = ivec2(gl_GlobalInvocationID.xy);
    ivec2 size = imageSize(target);
    if (p.x >= size.x || p.y >= size.y) return;
    ivec2 box = imageSize(upscaled);
    ivec2 q = p - (size - box) / 2;
    if (q.x < 0 || q.y < 0 || q.x >= box.x || q.y >= box.y) {
        imageStore(target, p, vec4(0.0, 0.0, 0.0, 1.0));
        return;
    }
    vec3 color;
    if (pc.sharpen != 0u) {
        FsrRcasF(color.r, color.g, color.b, uvec2(q), pc.con);
    } else {
        color = FsrRcasLoadF(q).rgb;
    }
    if (pc.overlayOpacity > 0.0) {
        vec4 o = texture(overlayTex, (vec2(q) + 0.5) / vec2(box));
        color = mix(color, o.rgb, o.a * pc.overlayOpacity);
    }
    if (pc.dither > 0.0) {
        // Interleaved gradient noise: the same pattern every frame, at the
        // display's pixel pitch. A value already on an 8-bit step stays on it.
        float n = fract(52.9829189 * fract(dot(vec2(p), vec2(0.06711056, 0.00583715))));
        color += (n - 0.5) * pc.dither / 255.0;
    }
    imageStore(target, p, vec4(color, 1.0));
}
